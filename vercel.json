{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/xero-success.html", "destination": "/xero-success.html" },
    { "source": "/((?!api|xero-success).*)", "destination": "/index.html" }
  ]
}
